<UserControl x:Class="kparser2.Views.ItemDropsViewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ListView ItemsSource="{Binding Events}">
        <ListView.View>
            <GridView>
                <GridViewColumn Header="Time" DisplayMemberBinding="{Binding Timestamp}" Width="120" />
                <GridViewColumn Header="Item" DisplayMemberBinding="{Binding ItemName}" Width="200" />
                <GridViewColumn Header="Source" DisplayMemberBinding="{Binding Source}" Width="160" />
                <GridViewColumn Header="Detail" DisplayMemberBinding="{Binding Detail}" Width="300" />
            </GridView>
        </ListView.View>
    </ListView>
</UserControl>
