<Window x:Class="kparser2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KParser 2" Height="800" Width="1200" MinHeight="480" MinWidth="760"
        WindowStartupLocation="CenterScreen" Background="#F5F6F8">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#D8DEE7" BorderThickness="0,0,0,1" Padding="12">
            <WrapPanel x:Name="SourceToolbar">
                <TextBlock Text="KParser 2" FontSize="20" FontWeight="SemiBold" Margin="0,0,24,0" VerticalAlignment="Center"/>
                <Button Content="Live" Click="OnUseLiveFeed" Padding="14,6" Margin="0,0,6,0"/>
                <Button Content="Open Capture…" Click="OnOpenCapture" Padding="14,6" Margin="0,0,6,0"/>
                <ComboBox x:Name="RecentCaptures" Width="170" Margin="0,0,6,0" ToolTip="Recent captures" SelectionChanged="OnRecentCapture"/>
                <Button Content="Open Report…" Click="OnOpenReport" Padding="14,6" Margin="0,0,6,0"/>
                <Button Content="Export Report…" Click="OnExportReport" Padding="14,6" Margin="0,0,6,0"/>
                <Button Content="New Session" Click="OnNewSession" Padding="14,6" Margin="0,0,6,0"/>
                <Button Content="Import PacketViewer…" Click="OnImportPacketViewer" Padding="14,6"/>
            </WrapPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="#E8EDF4" Padding="12,8">
            <StackPanel>
                <TextBlock x:Name="StatusText" Text="Waiting for kpacket" TextWrapping="Wrap"/>
                <TextBlock x:Name="CaptureText" Foreground="#526176" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="220" MinWidth="150" MaxWidth="360"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <DockPanel Margin="10">
                <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="0,0,0,10" Padding="8" ToolTip="Search all reports" TextChanged="OnSearchChanged"/>
                <ListBox x:Name="ReportList" BorderThickness="0" Background="Transparent" SelectionChanged="OnReportSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate>
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#526176" Margin="4,14,0,6"/>
                    </DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListBox.GroupStyle>
                    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" Margin="5"/></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>
            <DockPanel Grid.Column="2" Margin="12">
                <TextBlock x:Name="ReportTitle" DockPanel.Dock="Top" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <Border Background="White" BorderBrush="#D8DEE7" BorderThickness="1" Padding="8"><ContentControl x:Name="ReportContent"/></Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
