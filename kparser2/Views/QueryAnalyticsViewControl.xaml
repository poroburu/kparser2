<UserControl x:Class="kparser2.Views.QueryAnalyticsViewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Top" Text="{Binding StatusText}" Margin="0,0,0,8" />
        <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="True" IsReadOnly="True" />
    </DockPanel>
</UserControl>
