<Window x:Class="kparser2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KParser 2"
        Height="800"
        Width="1200"
        MinHeight="400"
        MinWidth="600"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Menu DockPanel.Dock="Top" x:Name="MainMenu">
            <MenuItem Header="Session">
                <MenuItem Header="Use Live Feed (5555)" Click="OnUseLiveFeed" />
                <MenuItem Header="Replay sample.ndjson" Click="OnReplaySample" />
                <MenuItem Header="Replay login.ndjson" Click="OnReplayLogin" />
                <MenuItem Header="Replay item_drop.ndjson" Click="OnReplayItemDrop" />
                <MenuItem Header="Replay combat_basic.ndjson" Click="OnReplayCombat" />
                <Separator />
                <MenuItem Header="Import PacketViewer…" Click="OnImportPacketViewer" />
            </MenuItem>
        </Menu>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready" />
            </StatusBarItem>
        </StatusBar>
        <TabControl x:Name="ViewTabs" />
    </DockPanel>
</Window>
